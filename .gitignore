# ======================
# Global ignores
# ======================
HELP.md
.DS_Store
Thumbs.db
*.swp

# ======================
# VS Code
# ======================
.vscode/

# ======================
# IntelliJ IDEA
# ======================
.idea/
*.iws
*.iml
*.ipr

# ======================
# NetBeans
# ======================
**/nbproject/private/
**/nbbuild/
**/dist/
**/nbdist/
**/.nb-gradle/

# ======================
# STS / Eclipse
# ======================
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ======================
# Frontend (React or similar)
# ======================
pft-frontend/node_modules/
pft-frontend/build/
pft-frontend/.env
pft-frontend/.parcel-cache/

# ======================
# Backend (Java / Maven)
# ======================

# Ignore Maven build output
pft-backend/target/

# Ignore wrapper JAR only (keep scripts + directory)
pft-backend/.mvn/wrapper/maven-wrapper.jar

# Ignore IDE-specific build output from backend
pft-backend/build/

# Ignore compiled JARs (optional, remove if prebuilding manually)
*.jar
